        <!-- 基础字段值 -->
        #{createTime, jdbcType=TIMESTAMP}, #{updateTime, jdbcType=TIMESTAMP},
        <!-- 业务字段值 -->
        #{organId, jdbcType=BIGINT}, #{revisionId, jdbcType=BIGINT}, #{chunkNo, jdbcType=INTEGER}, #{parentChunkNo, jdbcType=INTEGER}, #{sourceLocator, jdbcType=VARCHAR}, #{pageStart, jdbcType=INTEGER}, #{pageEnd, jdbcType=INTEGER}, #{tokenCount, jdbcType=INTEGER}, #{contentSha256, jdbcType=CHAR}, #{chunkStatus, jdbcType=VARCHAR}, #{titlePath, jdbcType=LONGVARCHAR},
        <!-- deleteFlag字段值（如果存在，设置默认值为0） -->
