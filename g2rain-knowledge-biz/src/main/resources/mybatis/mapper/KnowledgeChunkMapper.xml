    </sql>

    <!-- selectList / selectListWithoutIsolation 共用 -->
    <sql id="selectListBody">
        SELECT
        <!-- 主键字段 -->
        id,
        <!-- 基础字段 -->
        create_time, update_time,
        <!-- 业务字段 -->
        organ_id, revision_id, chunk_no, parent_chunk_no, source_locator, page_start, page_end, token_count, content_sha256, chunk_status, title_path,
        <!-- deleteFlag字段（如果存在） -->
        delete_flag,
        <!-- version字段（如果存在） -->
        version
        FROM knowledge_chunk
        <where>
            <!-- 主键筛选 -->
            <if test="id != null">
                AND id = #{id, jdbcType=BIGINT}
            </if>
            <if test="ids != null and ids.size() > 0">
                AND id IN
                <foreach collection="ids" item="item" open="(" separator="," close=")">
                    #{item, jdbcType=BIGINT}
                </foreach>
            </if>
            <!-- 基础字段筛选（createTime和updateTime时间筛选） -->
            <if test="createTime != null">
                <if test="createTime[0] != '' and (createTime.size() lt 2 or createTime[1] == '')">
                    AND create_time >= #{createTime[0], jdbcType=TIMESTAMP}
                </if>
                <if test="createTime.size() >= 2 and createTime[0] == '' and createTime[1] != ''">
                    AND create_time &lt;= #{createTime[1], jdbcType=TIMESTAMP}
                </if>
                <if test="createTime.size() >= 2 and createTime[0] != '' and createTime[1] != ''">
                    AND create_time BETWEEN #{createTime[0], jdbcType=TIMESTAMP}
                    AND #{createTime[1], jdbcType=TIMESTAMP}
                </if>
            </if>
            <if test="updateTime != null">
                <if test="updateTime[0] != '' and (updateTime.size() lt 2 or updateTime[1] == '')">
                    AND update_time >= #{updateTime[0], jdbcType=TIMESTAMP}
                </if>
                <if test="updateTime.size() >= 2 and updateTime[0] == '' and updateTime[1] != ''">
                    AND update_time &lt;= #{updateTime[1], jdbcType=TIMESTAMP}
                </if>
                <if test="updateTime.size() >= 2 and updateTime[0] != '' and updateTime[1] != ''">
                    AND update_time BETWEEN #{updateTime[0], jdbcType=TIMESTAMP}
                    AND #{updateTime[1], jdbcType=TIMESTAMP}
                </if>
            </if>
            <!-- 业务字段筛选 -->
            <if test="organId != null">
                AND organ_id = #{organId, jdbcType=BIGINT}
            </if>
            <if test="revisionId != null">
                AND revision_id = #{revisionId, jdbcType=BIGINT}
            </if>
            <if test="chunkNo != null">
                AND chunk_no = #{chunkNo, jdbcType=INTEGER}
            </if>
            <if test="parentChunkNo != null">
                AND parent_chunk_no = #{parentChunkNo, jdbcType=INTEGER}
            </if>
            <if test="sourceLocator != null">
                AND source_locator = #{sourceLocator, jdbcType=VARCHAR}
            </if>
            <if test="pageStart != null">
                AND page_start = #{pageStart, jdbcType=INTEGER}
            </if>
            <if test="pageEnd != null">
                AND page_end = #{pageEnd, jdbcType=INTEGER}
            </if>
            <if test="tokenCount != null">
                AND token_count = #{tokenCount, jdbcType=INTEGER}
            </if>
            <if test="contentSha256 != null">
                AND content_sha256 = #{contentSha256, jdbcType=CHAR}
            </if>
            <if test="chunkStatus != null">
                AND chunk_status = #{chunkStatus, jdbcType=VARCHAR}
            </if>
            <if test="titlePath != null">
                AND title_path = #{titlePath, jdbcType=LONGVARCHAR}
            </if>
            <!-- 过滤已删除的记录 -->
            AND (delete_flag = 0 OR delete_flag IS NULL)
        </where>
        <include refid="dynamicOrderBy"/>
    </sql>

    <!-- 插入单条记录 -->
    <insert id="insert" parameterType="com.g2rain.knowledge.dao.po.KnowledgeChunkPo">
        <include refid="insertBody"/>
    </insert>

