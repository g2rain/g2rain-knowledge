<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.g2rain.knowledge.dao.KnowledgeItemDao">
    <!-- 通用结果集映射（包含所有字段：主键+基础字段+业务字段） -->
    <resultMap id="BaseResultMap" type="com.g2rain.knowledge.dao.po.KnowledgeItemPo">
        <!-- 主键字段 -->
        <id column="id" property="id" jdbcType="BIGINT"/>
        <!-- 基础字段（createTime、updateTime） -->
        <result column="create_time" property="createTime" jdbcType="TIMESTAMP"/>
        <result column="update_time" property="updateTime" jdbcType="TIMESTAMP"/>
        <!-- 业务字段（其他自定义字段） -->
        <result column="organ_id" property="organId" jdbcType="BIGINT"/>
        <result column="category_id" property="categoryId" jdbcType="BIGINT"/>
        <result column="knowledge_key" property="knowledgeKey" jdbcType="VARCHAR"/>
        <result column="knowledge_name" property="knowledgeName" jdbcType="VARCHAR"/>
        <result column="knowledge_type" property="knowledgeType" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="create_user_id" property="createUserId" jdbcType="BIGINT"/>
        <!-- deleteFlag字段（如果存在） -->
        <result column="delete_flag" property="deleteFlag" jdbcType="TINYINT"/>
        <!-- version字段（如果存在） -->
        <result column="version" property="version" jdbcType="INTEGER"/>
    </resultMap>

    <!-- 定义可复用排序方向片段 -->
    <sql id="directionClause">
        <choose>
            <when test="item.direction == 'DESC'">DESC</when>
            <otherwise>ASC</otherwise>
        </choose>
    </sql>

    <!-- 可复用的动态排序 SQL 片段 -->
    <sql id="dynamicOrderBy">
        <trim prefix="ORDER BY" suffixOverrides=",">
            <foreach collection="safeSorts" item="item" separator=",">
                <choose>
                    <when test="item.column == 'id'">
                        id
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'createTime'">
                        create_time
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'updateTime'">
                        update_time
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'organId'">
                        organ_id
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'categoryId'">
                        category_id
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'knowledgeKey'">
                        knowledge_key
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'knowledgeName'">
                        knowledge_name
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'knowledgeType'">
                        knowledge_type
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'status'">
                        status
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'description'">
                        description
                        <include refid="directionClause"/>
                    </when>
                    <when test="item.column == 'createUserId'">
                        create_user_id
                        <include refid="directionClause"/>
                    </when>
                </choose>
            </foreach>
        </trim>
    </sql>

    <!-- insert / insertWithoutIsolation 共用 -->
    <sql id="insertBody">
        INSERT INTO knowledge_item (
        <!-- 主键字段（自增主键不包含在插入语句中） -->
        id,
        <!-- 基础字段 -->
        create_time, update_time,
        <!-- 业务字段 -->
        organ_id, category_id, knowledge_key, knowledge_name, knowledge_type, status, description, create_user_id,
        <!-- deleteFlag字段（如果存在） -->
        delete_flag,
        <!-- version字段（如果存在） -->
        version
        ) VALUES (
        <!-- 主键值（自增主键不包含） -->
        #{id, jdbcType=BIGINT},
        <!-- 基础字段值 -->
        #{createTime, jdbcType=TIMESTAMP}, #{updateTime, jdbcType=TIMESTAMP},
        <!-- 业务字段值 -->
        #{organId, jdbcType=BIGINT}, #{categoryId, jdbcType=BIGINT}, #{knowledgeKey, jdbcType=VARCHAR}, #{knowledgeName, jdbcType=VARCHAR}, #{knowledgeType, jdbcType=VARCHAR}, #{status, jdbcType=VARCHAR}, #{description, jdbcType=VARCHAR}, #{createUserId, jdbcType=BIGINT},
        <!-- deleteFlag字段值（如果存在，设置默认值为0） -->
        0,
        <!-- version字段值（如果存在，设置默认值为0） -->
        0
        )
    </sql>

    <!-- update / updateWithoutIsolation 共用 -->
    <sql id="updateBody">
        UPDATE knowledge_item
        <set>
            <!-- 基础字段更新（排除version，version单独处理） -->
            <if test="updateTime != null">
                update_time = #{updateTime, jdbcType=TIMESTAMP},
            </if>
            <!-- 业务字段更新 -->
            <if test="organId != null">
                organ_id = #{organId, jdbcType=BIGINT},
            </if>
            <if test="categoryId != null">
                category_id = #{categoryId, jdbcType=BIGINT},
            </if>
            <if test="knowledgeKey != null">
                knowledge_key = #{knowledgeKey, jdbcType=VARCHAR},
            </if>
            <if test="knowledgeName != null">
                knowledge_name = #{knowledgeName, jdbcType=VARCHAR},
            </if>
            <if test="knowledgeType != null">
                knowledge_type = #{knowledgeType, jdbcType=VARCHAR},
            </if>
            <if test="status != null">
                status = #{status, jdbcType=VARCHAR},
            </if>
            <if test="description != null">
                description = #{description, jdbcType=VARCHAR},
            </if>
            <if test="createUserId != null">
                create_user_id = #{createUserId, jdbcType=BIGINT},
            </if>
            <!-- version字段更新（如果存在，版本号自增） -->
            version = version + 1
        </set>
        WHERE id = #{id, jdbcType=BIGINT}
    </sql>

    <!-- selectById / selectByIdWithoutIsolation 共用 -->
    <sql id="selectByIdBody">
        SELECT
        <!-- 主键字段 -->
        id,
        <!-- 基础字段 -->
        create_time, update_time,
        <!-- 业务字段 -->
        organ_id, category_id, knowledge_key, knowledge_name, knowledge_type, status, description, create_user_id,
        <!-- deleteFlag字段（如果存在） -->
        delete_flag,
        <!-- version字段（如果存在） -->
        version
        FROM knowledge_item
        WHERE id = #{id, jdbcType=BIGINT}
        <!-- 过滤已删除的记录 -->
        AND (delete_flag = 0 OR delete_flag IS NULL)
    </sql>

    <!-- selectList / selectListWithoutIsolation 共用 -->
    <sql id="selectListBody">
        SELECT
        <!-- 主键字段 -->
        id,
        <!-- 基础字段 -->
        create_time, update_time,
        <!-- 业务字段 -->
        organ_id, category_id, knowledge_key, knowledge_name, knowledge_type, status, description, create_user_id,
        <!-- deleteFlag字段（如果存在） -->
        delete_flag,
        <!-- version字段（如果存在） -->
        version
        FROM knowledge_item
        <where>
            <!-- 主键筛选 -->
            <if test="id != null">
                AND id = #{id, jdbcType=BIGINT}
            </if>
            <if test="ids != null and ids.size() > 0">
                AND id IN
                <foreach collection="ids" item="item" open="(" separator="," close=")">
                    #{item, jdbcType=BIGINT}
                </foreach>
            </if>
            <!-- 基础字段筛选（createTime和updateTime时间筛选） -->
            <if test="createTime != null">
                <if test="createTime[0] != '' and (createTime.size() lt 2 or createTime[1] == '')">
                    AND create_time >= #{createTime[0], jdbcType=TIMESTAMP}
                </if>
                <if test="createTime.size() >= 2 and createTime[0] == '' and createTime[1] != ''">
                    AND create_time &lt;= #{createTime[1], jdbcType=TIMESTAMP}
                </if>
                <if test="createTime.size() >= 2 and createTime[0] != '' and createTime[1] != ''">
                    AND create_time BETWEEN #{createTime[0], jdbcType=TIMESTAMP}
                    AND #{createTime[1], jdbcType=TIMESTAMP}
                </if>
            </if>
            <if test="updateTime != null">
                <if test="updateTime[0] != '' and (updateTime.size() lt 2 or updateTime[1] == '')">
                    AND update_time >= #{updateTime[0], jdbcType=TIMESTAMP}
                </if>
                <if test="updateTime.size() >= 2 and updateTime[0] == '' and updateTime[1] != ''">
                    AND update_time &lt;= #{updateTime[1], jdbcType=TIMESTAMP}
                </if>
                <if test="updateTime.size() >= 2 and updateTime[0] != '' and updateTime[1] != ''">
                    AND update_time BETWEEN #{updateTime[0], jdbcType=TIMESTAMP}
                    AND #{updateTime[1], jdbcType=TIMESTAMP}
                </if>
            </if>
            <!-- 业务字段筛选 -->
            <if test="organId != null">
                AND organ_id = #{organId, jdbcType=BIGINT}
            </if>
            <if test="categoryId != null">
                AND category_id = #{categoryId, jdbcType=BIGINT}
            </if>
            <if test="knowledgeKey != null">
                AND knowledge_key = #{knowledgeKey, jdbcType=VARCHAR}
            </if>
            <if test="knowledgeName != null">
                AND knowledge_name = #{knowledgeName, jdbcType=VARCHAR}
            </if>
            <if test="knowledgeType != null">
                AND knowledge_type = #{knowledgeType, jdbcType=VARCHAR}
            </if>
            <if test="status != null">
                AND status = #{status, jdbcType=VARCHAR}
            </if>
            <if test="description != null">
                AND description = #{description, jdbcType=VARCHAR}
            </if>
            <if test="createUserId != null">
                AND create_user_id = #{createUserId, jdbcType=BIGINT}
            </if>
            <!-- 过滤已删除的记录 -->
            AND (delete_flag = 0 OR delete_flag IS NULL)
        </where>
        <include refid="dynamicOrderBy"/>
    </sql>

    <!-- 插入单条记录 -->
    <insert id="insert" parameterType="com.g2rain.knowledge.dao.po.KnowledgeItemPo">
        <include refid="insertBody"/>
    </insert>

    <!-- 批量插入记录 -->
    <insert id="insertMultiple" parameterType="java.util.List">
        INSERT INTO knowledge_item (
        <!-- 主键字段（自增主键不包含） -->
        id,
        <!-- 基础字段 -->
        create_time, update_time,
        <!-- 业务字段 -->
        organ_id, category_id, knowledge_key, knowledge_name, knowledge_type, status, description, create_user_id,
        <!-- deleteFlag字段（如果存在） -->
        delete_flag,
        <!-- version字段（如果存在） -->
        version
        ) VALUES
        <foreach collection="list" item="item" separator=",">
            (
            <!-- 主键值（自增主键不包含） -->
            #{item.id, jdbcType=BIGINT},
            <!-- 基础字段值 -->
            #{item.createTime, jdbcType=TIMESTAMP}, #{item.updateTime, jdbcType=TIMESTAMP},
            <!-- 业务字段值 -->
            #{item.organId, jdbcType=BIGINT}, #{item.categoryId, jdbcType=BIGINT}, #{item.knowledgeKey, jdbcType=VARCHAR}, #{item.knowledgeName, jdbcType=VARCHAR}, #{item.knowledgeType, jdbcType=VARCHAR}, #{item.status, jdbcType=VARCHAR}, #{item.description, jdbcType=VARCHAR}, #{item.createUserId, jdbcType=BIGINT},
            <!-- deleteFlag字段值（如果存在，设置默认值为0） -->
            0,
            <!-- version字段值（如果存在，设置默认值为0） -->
            0
            )
        </foreach>
    </insert>

    <!-- 根据 ID 更新记录（包含基础字段和业务字段） -->
    <update id="update" parameterType="com.g2rain.knowledge.dao.po.KnowledgeItemPo">
        <include refid="updateBody"/>
    </update>

    <!-- 根据 ID 和 Version 更新记录（乐观锁更新，包含基础字段和业务字段） -->
    <update id="updateByVersion" parameterType="com.g2rain.knowledge.dao.po.KnowledgeItemPo">
        UPDATE knowledge_item
        <set>
            <!-- 基础字段更新（排除version，version单独处理） -->
            <if test="updateTime != null">
                update_time = #{updateTime, jdbcType=TIMESTAMP},
            </if>
            <!-- 业务字段更新 -->
            <if test="organId != null">
                organ_id = #{organId, jdbcType=BIGINT},
            </if>
            <if test="categoryId != null">
                category_id = #{categoryId, jdbcType=BIGINT},
            </if>
            <if test="knowledgeKey != null">
                knowledge_key = #{knowledgeKey, jdbcType=VARCHAR},
            </if>
            <if test="knowledgeName != null">
                knowledge_name = #{knowledgeName, jdbcType=VARCHAR},
            </if>
            <if test="knowledgeType != null">
                knowledge_type = #{knowledgeType, jdbcType=VARCHAR},
            </if>
            <if test="status != null">
                status = #{status, jdbcType=VARCHAR},
            </if>
            <if test="description != null">
                description = #{description, jdbcType=VARCHAR},
            </if>
            <if test="createUserId != null">
                create_user_id = #{createUserId, jdbcType=BIGINT},
            </if>
            <!-- version字段更新（乐观锁版本号自增） -->
            version = version + 1
        </set>
        WHERE id = #{id, jdbcType=BIGINT}
        AND version = #{version, jdbcType=INTEGER}
    </update>

    <!-- 根据 ID 删除记录（逻辑删除：将delete_flag设置为true） -->
    <update id="delete" parameterType="Long">
        UPDATE knowledge_item
        <set>
            delete_flag = 1, version = version + 1
        </set>
        WHERE id = #{id, jdbcType=BIGINT}
        <!-- 只删除未删除的记录 -->
        AND (delete_flag = 0 OR delete_flag IS NULL)
    </update>

    <!-- 根据 ID 查询记录（查询所有字段） -->
    <select id="selectById" parameterType="Long" resultMap="BaseResultMap">
        <include refid="selectByIdBody"/>
    </select>

    <!-- 根据 SelectDto 条件查询列表 -->
    <select id="selectList" parameterType="com.g2rain.knowledge.dto.KnowledgeItemSelectDto" resultMap="BaseResultMap">
        <include refid="selectListBody"/>
    </select>

    <!-- 插入单条记录（忽略数据隔离） -->
    <insert id="insertWithoutIsolation" parameterType="com.g2rain.knowledge.dao.po.KnowledgeItemPo">
        <include refid="insertBody"/>
    </insert>

    <!-- 根据 ID 更新记录（忽略数据隔离） -->
    <update id="updateWithoutIsolation" parameterType="com.g2rain.knowledge.dao.po.KnowledgeItemPo">
        <include refid="updateBody"/>
    </update>

    <!-- 根据 ID 查询记录（忽略数据隔离） -->
    <select id="selectByIdWithoutIsolation" parameterType="Long" resultMap="BaseResultMap">
        <include refid="selectByIdBody"/>
    </select>

    <!-- 根据 SelectDto 条件查询列表（忽略数据隔离） -->
    <select id="selectListWithoutIsolation" parameterType="com.g2rain.knowledge.dto.KnowledgeItemSelectDto" resultMap="BaseResultMap">
        <include refid="selectListBody"/>
    </select>
</mapper>
